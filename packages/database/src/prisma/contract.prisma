// use prisma-8

model User {
  id              Uuid         @id @default(uuid())
  email           String       @unique
  googleSub       String?      @unique @map("google_sub")
  emailVerifiedAt Timestamptz? @map("email_verified_at")
  status          String       @default("pending")
  createdAt       Timestamptz  @default(now()) @map("created_at")
  updatedAt       temporal.updatedAt() @map("updated_at")
  deletedAt       Timestamptz? @map("deleted_at")

  profile         Profile?
  sessions        Session[]

  @@map("users")
}

model Profile {
  userId      Uuid         @id @map("user_id")
  displayName String?      @map("display_name")
  avatarUrl   String?      @map("avatar_url")
  phoneNumber String?      @map("phone_number")
  dateOfBirth Date?        @map("date_of_birth")
  createdAt   Timestamptz  @default(now()) @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id         Uuid          @id @default(uuid())
  userId     Uuid          @map("user_id")
  deviceName String?       @map("device_name")
  userAgent  String?       @map("user_agent")
  ipAddress  Inet?         @map("ip_address")
  createdAt  Timestamptz   @default(now()) @map("created_at")
  lastSeenAt Timestamptz   @default(now()) @map("last_seen_at")
  expiresAt  Timestamptz   @map("expires_at")
  revokedAt  Timestamptz?  @map("revoked_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        Uuid         @id @default(uuid())
  sessionId Uuid         @map("session_id")
  tokenHash String       @unique @map("token_hash")
  createdAt Timestamptz  @default(now()) @map("created_at")
  expiresAt Timestamptz  @map("expires_at")
  revokedAt Timestamptz? @map("revoked_at")

  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}
