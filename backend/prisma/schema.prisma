// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isBanned        Boolean   @default(false) @map("is_banned")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  session  Session?
  profiles Profile?

  @@index([email])
  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  deviceName String? @map("device_name")
  deviceType String? @map("device_type")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, refreshTokenHash])
  @@map("sessions")
}

model Profile {
  id String @id @db.Uuid

  fullname  String    @map("full_name")
  dob       DateTime? @db.Date
  gender    Gender
  avatarUrl String?   @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([fullname])
  @@map("profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Movie {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  posterUrl    String   @map("poster_url")
  overview     String
  language     String
  releasedDate DateTime @map("released_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shows Show[]

  @@index([language])
  @@map("movies")
}

model Theater {
  id              String @id @default(uuid()) @db.Uuid
  name            String
  city            String
  avatarUrl       String @map("avatar_url")
  address         String
  rating          Float
  seatingCapacity Int    @map("seating_capacity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seats TheaterSeat[]
  shows Show[]

  @@index([city])
  @@map("theaters")
}

model TheaterSeat {
  id         String @id @default(uuid()) @db.Uuid
  theaterId  String @map("theater_id") @db.Uuid
  rowName    String @map("row_name")
  seatNumber Int    @map("seat_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  theater   Theater    @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  showSeats ShowSeat[]

  @@unique([theaterId, rowName, seatNumber])
  @@index([theaterId])
  @@map("theater_seats")
}

model Show {
  id           String   @id @default(uuid()) @db.Uuid
  movieId      String   @map("movie_id") @db.Uuid
  theaterId    String   @map("theater_id") @db.Uuid
  onDate       DateTime @map("on_date") @db.Date
  startTime    DateTime @map("start_time") @db.Time(0)
  endTime      DateTime @map("end_time") @db.Time(0)
  duration     Int
  onwardAmount Decimal  @map("onward_amount") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  theater Theater @relation(fields: [theaterId], references: [id], onDelete: Cascade)

  showSeats ShowSeat[]

  @@index([movieId])
  @@index([theaterId])
  @@index([onDate])
  @@index([theaterId, onDate])
  @@map("shows")
}

model ShowSeat {
  id     String     @id @default(uuid()) @db.Uuid
  seatId String     @map("seat_id") @db.Uuid
  showId String     @map("show_id") @db.Uuid
  status SeatStatus @default(AVAILABLE)
  price  Decimal    @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seat TheaterSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  show Show        @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, seatId])
  @@index([showId])
  @@index([seatId])
  @@index([status])
  @@map("show_seats")
}

enum SeatStatus {
  BOOKED
  HELD
  AVAILABLE
}
